{
  "name": "voting-pvm-zkvm",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "remixd": "npx remixd -s ./verifier-contract -u https://remix.polkadot.io",
    "contracts:export": "pnpm --filter=verifier-contract export",
    "contracts:build": "pnpm --filter=verifier-contract build",
    "contracts:deploy": "pnpm --filter=verifier-contract deploy-contracts",
    "contracts:compile": "pnpm --filter=verifier-contract compile",
    "contracts:clean": "pnpm --filter=verifier-contract clean",
    "frontend:dev": "pnpm --filter=frontend dev",
    "frontend:build": "pnpm --filter=frontend build",
    "frontend:lint": "pnpm --filter=frontend lint",
    "frontend:lint:fix": "pnpm --filter=frontend lint:fix",
    "frontend:preview": "pnpm --filter=frontend preview"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@remix-project/remixd": "^0.6.40",
    "hardhat": "^2.24.1",
    "typescript": "~5.6.2"
  }
}
